    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.4",
    "bootstrap": "5.3.8",
    "express": "5.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "20.19.0",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
