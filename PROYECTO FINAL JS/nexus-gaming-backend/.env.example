# Copia este archivo como .env y ajusta los valores (el servidor lo lee solo, sin librerías).
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Clave con la que se firman las sesiones. DEFÍNELA con un valor largo y aleatorio fuera del laboratorio.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# json = sin instalar nada (archivo data/db.json) | postgres = bases distribuidas con FDW
DB_DRIVER=json

# Solo si DB_DRIVER=postgres (ver ../database/README.md)
PG_HOST=localhost
PG_PORT=5432
PG_USER=admin_nova
PG_PASSWORD=cambiar_esta_clave
PG_DB_CENTRAL=nexus_central
PG_DB_NORTE=nexus_trujillo
PG_DB_SUR=nexus_arequipa
PG_DB_CENTRO=nexus_cusco

# Opcional: asistente de soporte con un modelo de lenguaje (si falla o no hay clave, usa el motor local)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
